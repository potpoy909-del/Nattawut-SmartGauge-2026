// REDLINE Gauge 1.7.0 XPT2046 bit-banged touch driver (ported)
#ifndef TOUCH_Z_MIN
#define TOUCH_Z_MIN 150
#endif
class Xpt2046Touch {
public:
  Xpt2046Touch(int cs,int clk,int din,int dout):cs_(cs),clk_(clk),din_(din),dout_(dout){}
  void begin(){ pinMode(cs_,OUTPUT); digitalWrite(cs_,HIGH); pinMode(clk_,OUTPUT); digitalWrite(clk_,LOW); pinMode(din_,OUTPUT); digitalWrite(din_,LOW); pinMode(dout_,INPUT); read12(0xD0); }
  void setCal(int xmin,int xmax,int ymin,int ymax,int xr,int yr,bool axis){xmin_=xmin;xmax_=xmax;ymin_=ymin;ymax_=ymax;xr_=xr;yr_=yr;axis_=axis;}
  bool Pressed(){
    z_=read12(0xB1); if(z_<TOUCH_Z_MIN){read12(0xD0);return false;}
    uint16_t cx=median5(0x91), cy=median5(0xD1);
    bool down=read12(0xB1)>=TOUCH_Z_MIN && cx>40 && cx<4055 && cy>40 && cy<4055;
    read12(0xD0); if(!down)return false;
    rawX_=axis_?cx:cy; rawY_=axis_?cy:cx;
    x_=mapCal(rawX_,xmin_,xmax_,xr_); y_=mapCal(rawY_,ymin_,ymax_,yr_); return true;
  }
  uint16_t X(){return x_;} uint16_t Y(){return y_;}
private:
  int cs_,clk_,din_,dout_,xmin_=526,xmax_=3443,ymin_=750,ymax_=3377,xr_=320,yr_=240; bool axis_=true;
  uint16_t x_=0,y_=0,rawX_=0,rawY_=0,z_=0;
  uint16_t read12(uint8_t cmd){digitalWrite(cs_,LOW);for(int i=7;i>=0;i--){digitalWrite(din_,(cmd>>i)&1);delayMicroseconds(1);digitalWrite(clk_,HIGH);delayMicroseconds(1);digitalWrite(clk_,LOW);}uint16_t v=0;for(int i=0;i<16;i++){delayMicroseconds(1);digitalWrite(clk_,HIGH);delayMicroseconds(1);digitalWrite(clk_,LOW);v=(v<<1)|digitalRead(dout_);}digitalWrite(cs_,HIGH);return v>>4;}
  uint16_t median5(uint8_t cmd){uint16_t a[5];for(int i=0;i<5;i++)a[i]=read12(cmd);for(int i=1;i<5;i++)for(int j=i;j>0&&a[j]<a[j-1];j--){uint16_t t=a[j];a[j]=a[j-1];a[j-1]=t;}return a[2];}
  int mapCal(long v,int lo,int hi,int res){if(lo==hi)return 0;long n=(v-lo)*(long)(res-60)/(hi-lo)+30;return constrain(n,0,res-1);}
};
