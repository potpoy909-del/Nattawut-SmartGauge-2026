    tft.print("SELECT BORDER COLOR (15 COLORS)");

    uint16_t sampleColors[15] = {
        0x07FF, 0xFD20, 0x07E0, 0xF800, 0xFFE0, 
        0xF81F, 0x001F, 0xFFFF, 0xFE19, 0x780F, 
        0xFC60, 0x03EF, 0xFBE4, 0x8410, 0x5745  
    };

    int startX = px + 12;
    int startY = py + 26;
    int boxW = 50;
    int boxH = 34;
    int spacingX = 8;
    int spacingY = 6;

    for (int i = 0; i < 15; i++) {
        int col = i % 5;
        int row = i / 5;
        int bx = startX + col * (boxW + spacingX);
        int by = startY + row * (boxH + spacingY);

        tft.fillRect(bx, by, boxW, boxH, sampleColors[i]);
        if (i == settingBorderColor) {
            tft.drawRect(bx - 2, by - 2, boxW + 4, boxH + 4, ILI9341_WHITE);
            tft.drawRect(bx - 1, by - 1, boxW + 2, boxH + 2, ILI9341_WHITE);
        } else {
            tft.drawRect(bx, by, boxW, boxH, 0x7BEF);
        }
    }
}

void handleColorPickerTouch(int x, int y) {
    int px = 10;
    int py = 25;
    int pw = 300;
    int ph = 152;
    int startX = px + 12;
    int startY = py + 26;
    int boxW = 50;
    int boxH = 34;
    int spacingX = 8;
    int spacingY = 6;

    for (int i = 0; i < 15; i++) {
        int col = i % 5;
        int row = i / 5;
        int bx = startX + col * (boxW + spacingX);
        int by = startY + row * (boxH + spacingY);

        if (x >= bx && x <= bx + boxW && y >= by && y <= by + boxH) {
            settingBorderColor = i;
            EEPROM.write(1, settingBorderColor);
            EEPROM.commit();
            isChoosingColor = false;
            delay(150); 
            drawCurrentPage(); 
            return;
        }
    }
}

void drawSmoothBar(int x, int y, int w, int h, float percent, int *lastFillW) {
    if (percent < 0) percent = 0;
    if (percent > 100) percent = 100;
    int fillW = ((w - 2) * percent) / 100;

    if (*lastFillW == -1) {
        tft.drawRect(x, y, w, h, 0x39E4);
        tft.fillRect(x + 1, y + 1, w - 2, h - 2, ILI9341_BLACK);
        *lastFillW = 0;
    }

    if (fillW != *lastFillW) {
        int maxLen = w - 2;
        if (fillW > *lastFillW) {
            for (int i = *lastFillW; i < fillW; i++) {
                uint16_t color;
                float ratio = (float)i / maxLen;
                int r, g, b = 0;
                if (ratio < 0.5) {
                    float subRatio = ratio * 2.0;
                    r = (int)(subRatio * 31.0);
                    g = 63;
                } else {
                    float subRatio = (ratio - 0.5) * 2.0;
                    r = 31;
                    g = (int)((1.0 - subRatio) * 63.0);
                }
                color = tft.color565(r * 8, g * 4, b * 8);
                tft.drawFastVLine(x + 1 + i, y + 1, h - 2, color);
            }
        } else {
            tft.fillRect(x + 1 + fillW, y + 1, *lastFillW - fillW, h - 2, ILI9341_BLACK);
        }
        *lastFillW = fillW;
    }
}

