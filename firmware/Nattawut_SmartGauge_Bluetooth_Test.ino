void updateLiveValues() {
    char buf[15];

    if (currentPage == 1) {
        // Speed bar: keep the logo background visible when VSS is unavailable.
        // Draw a normal filled bar only after a valid speed value is received.
        static int lastSpeedBarMode = -1; // -1 not drawn, 0 unavailable, 1 live speed
        int speedBarMode = realSpeedAvailable ? 1 : 0;
        if (speedBarMode != lastSpeedBarMode || lastSpeedFillW == -1) {
            if (realSpeedAvailable) {
                lastSpeedFillW = -1;
                drawSmoothBar(6, 42, 102, 8, (realSpeed * 100.0) / 200.0, &lastSpeedFillW);
            } else {
                restoreLogoRect(6, 42, 102, 8);
                tft.drawRect(6, 42, 102, 8, 0x39E4);
                lastSpeedFillW = 0;
            }
            lastSpeedBarMode = speedBarMode;
        } else if (realSpeedAvailable) {
            drawSmoothBar(6, 42, 102, 8, (realSpeed * 100.0) / 200.0, &lastSpeedFillW);
        }

        // Show 0 at startup instead of N/A. When a verified VSS decoder
        // supplies realSpeed and sets realSpeedAvailable=true, the same field
        // will display the live speed value.
        static bool lastSpeedAvailMain = false;
        if (realSpeed != lastDisplayedSpeed || realSpeedAvailable != lastSpeedAvailMain) {
            lastDisplayedSpeed = realSpeed;
            lastSpeedAvailMain = realSpeedAvailable;
            tft.setTextSize(3);
            restoreLogoRect(22, 72, 82, 28);
            tft.setTextColor(0xFFFF);
            tft.setCursor(25, 75);
            snprintf(buf, sizeof(buf), "%3d", realSpeed);
            tft.print(buf);
        }

        tft.setTextSize(1);
        tft.setTextColor(0x07FF);
        tft.setCursor(75, 108);
        tft.print("km/h"); 

        drawSmoothBar(118, 42, 102, 8, (realRpm * 100.0) / 10000.0, &lastRpmFillW);

        if (realRpm != lastDisplayedRpm) {
            lastDisplayedRpm = realRpm;
            sprintf(buf, "%5d", realRpm);
            tft.setTextSize(2);
            restoreLogoRect(121, 75, 96, 24);
            tft.setTextColor(0xFFE0); // transparent text over logo background
            tft.setCursor(125, 78);
            tft.print(buf); 
        }
        
        tft.setTextSize(1); 
        tft.setTextColor(0xF81F); // transparent label
        tft.setCursor(195, 108); tft.print("RPM"); 

        if (realTps != lastDisplayedTpsVal) {
            lastDisplayedTpsVal = realTps;
            restoreLogoRect(228, 31, 67, 15);
            tft.setTextSize(1); 
            tft.setTextColor(0x07FF);
            tft.setCursor(232, 39); tft.print("TPS:");
            sprintf(buf, "%3d%%", realTps);
            tft.setTextColor(0xFFFF); 
            tft.setCursor(258, 39); tft.print(buf);
        }

        if (realEct != lastDisplayedEctVal) {
            lastDisplayedEctVal = realEct;
            restoreLogoRect(228, 65, 67, 15);
            tft.setTextColor(0xFFE0);
            tft.setCursor(232, 73); tft.print("ECT:");
            sprintf(buf, "%3d C", realEct);
            tft.setTextColor(0xFFFF); 
            tft.setCursor(258, 73); tft.print(buf);
        }

        if (realBatt != lastDisplayedBatVal) {
            lastDisplayedBatVal = realBatt;
            // Restore the original dimmed logo/background in the entire BAT value area.
            // Do not paint a black rectangle behind the reading.
            restoreLogoRect(228, 99, 88, 19);
            tft.setTextSize(1);
            tft.setTextColor(0x07E0);
            tft.setCursor(232, 109); tft.print("BAT:");
            dtostrf(realBatt, 4, 1, buf); strcat(buf, "V");
            tft.setTextColor(0xFFFF);
            tft.setCursor(258, 109); tft.print(buf);
        }

        tft.setTextSize(2); 

        // Bottom ECT and BAT values occupy separate 76 px panels.
        // Restore each panel background before drawing the new value. This
        // removes old digits cleanly and prevents one value spilling over.
        if (realEct != lastDisplayedEct) {
            lastDisplayedEct = realEct;
            snprintf(buf, sizeof(buf), "%d C", realEct);
            restoreLogoRect(3, 151, 74, 29);
            tft.setFont();
            tft.setTextSize(2);
            tft.setTextColor(0xFFFF);
            int valueW = (int)strlen(buf) * 12;
            tft.setCursor(3 + (74 - valueW) / 2, 160);
            tft.print(buf);
        }

        if (realBatt != lastDisplayedBatt) {
            lastDisplayedBatt = realBatt;
            char battBuf[12];
            dtostrf(realBatt, 4, 1, battBuf);
            char *p = battBuf;
            while (*p == ' ') p++;
            char valueBuf[12];
            snprintf(valueBuf, sizeof(valueBuf), "%sV", p);
            restoreLogoRect(81, 151, 74, 29);
            tft.setFont();
            tft.setTextSize(2);
            tft.setTextColor(0xFFFF);
            int valueW = (int)strlen(valueBuf) * 12;
            tft.setCursor(81 + (74 - valueW) / 2, 160);
            tft.print(valueBuf);
        }

        drawEngineStatusPanel();

        // Keep the small green battery symbol in the UPPER-RIGHT BAT panel.
        // Also draw the requested small icon in the LOWER BATT panel.
        // These icons are separate and do not change either voltage reading.
        drawBatteryIcon(298, 106, 0x07E0);
        drawBatteryIcon(136, 136, 0x07E0);

    }
    else if (currentPage == 2) {
        if (realRpm != lastDisplayedRpm) {
            lastDisplayedRpm = realRpm;
            sprintf(buf, "%5d", realRpm);
            restoreLogoRect(38, 59, 108, 39);
            tft.setTextColor(0xFFFF); // V7: all gauge-page numeric values white
            tft.setTextSize(3);
            tft.setCursor(44, 63);
            tft.print(buf); 
        }

        drawSmoothBar(6, 115, 171, 10, (realRpm * 100.0) / 10000.0, &lastRpmFillW);

        if (realTps != lastDisplayedTpsBarVal) {
            lastDisplayedTpsBarVal = realTps;
            restoreLogoRect(181, 31, 114, 15);
            tft.setTextSize(1); 
            tft.setTextColor(0x07FF);
            tft.setCursor(183, 39); tft.print("TPS BAR:");
            sprintf(buf, "%3d%%", realTps);
            tft.setTextColor(0xFFFF); 
            tft.setCursor(250, 39); tft.print(buf);
        }
        drawSmoothBar(183, 60, 131, 8, (realTps * 100.0) / 100.0, &lastTpsFillW);

        if (realEct != lastDisplayedEctBarVal) {
            lastDisplayedEctBarVal = realEct;
            tft.setTextSize(1); 
            restoreLogoRect(181, 85, 114, 15);
            tft.setTextColor(0x07E0);
            tft.setCursor(183, 93); tft.print("ECT BAR:");
            sprintf(buf, "%3d C", realEct);
            tft.setTextColor(0xFFFF); 
            tft.setCursor(250, 93); tft.print(buf);
        }
        drawSmoothBar(183, 114, 131, 8, (realEct * 100.0) / 120.0, &lastEctFillW);

        tft.setTextSize(2);

        // O2: show 0.00 V until a valid Table 0x20 response is decoded.
        if (realO2Available) {
            if (realO2Volts != lastDisplayedO2Volts) {
                lastDisplayedO2Volts = realO2Volts;
                char o2buf[16];
                dtostrf(realO2Volts, 4, 2, o2buf);
                strcat(o2buf, " V");
                restoreLogoRect(4, 151, 100, 27);
                tft.setTextSize(2);
                tft.setTextColor(0xFFFF);
                tft.setCursor(10, 158);
                tft.print(o2buf);
            }
        } else if (lastDisplayedO2Volts != 0.0f) {
            lastDisplayedO2Volts = 0.0f;
            restoreLogoRect(4, 151, 100, 27);
            tft.setTextSize(2);
            tft.setTextColor(0xFFFF);
            tft.setCursor(10, 158);
            tft.print("0.00 V");
        }

        // AFR estimate derived from live narrowband O2 voltage.
        // Display 0.0 at startup until a valid O2 response is received.
        // This is approximate; accurate AFR requires a calibrated wideband sensor.
        const bool afrAvailable = realO2Available;
        const float afrValue = realAfrEstimate;
        if (afrValue != lastDisplayedAfr || afrAvailable != lastDisplayedAfrAvailable) {
            lastDisplayedAfr = afrValue;
            lastDisplayedAfrAvailable = afrAvailable;
            restoreLogoRect(110, 151, 100, 27);
            tft.setTextSize(2);
            tft.setTextColor(0xFFFF);
            tft.setCursor(114, 158);
            if (afrAvailable) tft.printf("%.1f", afrValue);
            else tft.print("0.0");
        }

        // IGN remains a zero placeholder until the Honda ECU byte position/scaling
        // is verified from captured responses. No unverified live value is shown.
        // Demo formula is compile-time opt-in and is OFF by default.
#if IGN_DEMO_MODE
        // TEST ONLY: formula based on user-provided synthetic examples.
        // This is not a verified Honda ECU VAR_3001 decoder.
        const float ignValue = ((float)IGN_DEMO_RAW * 0.5f) + 4.0f;
        const bool ignAvailable = true;
#else
        const float ignValue = -999.0f;
        const bool ignAvailable = false;
#endif
        if (!lastIgnPlaceholderDrawn || ignValue != demoIgnValue) {
            demoIgnValue = ignValue;
            restoreLogoRect(216, 153, 100, 27);
            tft.setTextSize(2);
            tft.setTextColor(0xFFFF);
            tft.setCursor(220, 158);
            if (ignAvailable) tft.printf("%.1f", ignValue);
            else tft.print("0.0");
            tft.setTextSize(1);
            tft.setCursor(278, 169);
            tft.print("deg");
            lastIgnPlaceholderDrawn = true;
        }

    }
}

