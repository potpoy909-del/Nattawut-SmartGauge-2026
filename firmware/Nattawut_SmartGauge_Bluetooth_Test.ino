void drawDtcPage() {
    uint16_t bColor = getBorderThemeColor();
    drawHeader("DTC", "4/6");

    // Full-width DTC table across the display.
    const int tableX = 2;
    const int tableY = 25;
    const int tableW = 316;
    const int tableH = 112;
    const int headerH = 21;
    const int rowH = 22;

    tft.fillRect(tableX, tableY, tableW, tableH, ILI9341_BLACK);
    tft.drawRect(tableX, tableY, tableW, tableH, bColor);
    tft.fillRect(tableX + 1, tableY + 1, tableW - 2, headerH - 1, 0x0841);
    tft.drawFastHLine(tableX, tableY + headerH, tableW, bColor);

    // Column dividers are hidden in the empty/status state so the cyan
    // ECU status message can use one full-width row without crossing lines.
    const int col1 = 67;
    const int col2 = 220;
    if (dtcCount > 0) {
        tft.drawFastVLine(col1, tableY, tableH, bColor);
        tft.drawFastVLine(col2, tableY, tableH, bColor);
    }

    tft.setTextSize(1);
    tft.setTextColor(0xFFFF, 0x0841);
    tft.setCursor(10, 31);  tft.print("Code");
    tft.setCursor(77, 31);  tft.print("Description");
    tft.setCursor(230, 31); tft.print("Status");

    for (int i = 1; i <= 4; i++) {
        int lineY = tableY + headerH + (i * rowH);
        if (lineY < tableY + tableH) tft.drawFastHLine(tableX, lineY, tableW, bColor);
    }

    if (dtcCount == 0) {
        // Full-width status message, centered and kept inside the table border.
        tft.setTextColor(0x07FF, ILI9341_BLACK);
        String statusLine = dtcScanStatus;
        if (statusLine.length() > 50) statusLine = statusLine.substring(0, 50);
        int statusX = (320 - (statusLine.length() * 6)) / 2;
        if (statusX < tableX + 5) statusX = tableX + 5;
        tft.setCursor(statusX, 57);
