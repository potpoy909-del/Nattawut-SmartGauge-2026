// GPS speed state must be declared before serviceGps() uses it.
int realSpeed = 0;
bool realSpeedAvailable = false;

static void serviceGps() {
    while (Serial1.available()) {
        char c = (char)Serial1.read();
        if (c == '\r') continue;
        if (c == '\n') {
            if (gpsNmeaLine.startsWith("$GPRMC,") || gpsNmeaLine.startsWith("$GNRMC,")) {
                String fields[12]; int field = 0;
                for (size_t i = 0; i < gpsNmeaLine.length() && field < 12; ++i) {
                    char ch = gpsNmeaLine[i];
                    if (ch == ',' || ch == '*') { field++; if (ch == '*') break; }
                    else fields[field] += ch;
                }
                // RMC status A means valid; speed field is knots (field 7).
                if (field > 7 && fields[2] == "A" && fields[7].length()) {
                    float knots = fields[7].toFloat();
                    if (knots >= 0.0f && knots < 400.0f) {
                        realSpeed = (int)(knots * 1.852f + 0.5f);
                        realSpeedAvailable = true;
                        lastGpsFixMs = millis();
                    }
                }
            }
            gpsNmeaLine = "";
        } else if (c >= 32 && c <= 126 && gpsNmeaLine.length() < 100) {
            gpsNmeaLine += c;
        } else if (c == '$') {
            gpsNmeaLine = "$";
        }
    }
    if (lastGpsFixMs && millis() - lastGpsFixMs > 3000UL) realSpeedAvailable = false;
}

