// Bluetooth SPP command channel. Only harmless link/status queries are accepted.
static char btCommandBuffer[48];
static uint8_t btCommandLength = 0;

static void serviceBluetoothCommands() {
    while (SerialBT.available() > 0) {
        const char c = (char)SerialBT.read();
        if (c == '\r') continue;
        if (c == '\n') {
            btCommandBuffer[btCommandLength] = '\0';
            if (strcmp(btCommandBuffer, "PING") == 0) {
                SerialBT.print("NATTWUT_ACK,PING,OK\r\n");
            } else if (strcmp(btCommandBuffer, "STATUS") == 0) {
                SerialBT.print("NATTWUT_STATUS,1,");
                SerialBT.print(klineInitOk ? "KLINE_INIT_OK" : "KLINE_NOT_READY");
                SerialBT.print(',');
                SerialBT.print(ecuResponseDetected ? "ECU_RESPONSE" : "NO_ECU_RESPONSE");
                SerialBT.print("\r\n");
            } else if (btCommandLength > 0) {
                SerialBT.print("NATTWUT_ACK,UNKNOWN,");
                SerialBT.print(btCommandBuffer);
                SerialBT.print("\r\n");
            }
            btCommandLength = 0;
        } else if (btCommandLength < sizeof(btCommandBuffer) - 1) {
            btCommandBuffer[btCommandLength++] = c;
        } else {
            btCommandLength = 0;
        }
    }
}

void setup() {
    DebugSerial.begin(115200);
    SerialBT.begin("Nattawut ECU"); // Pair from Android Bluetooth settings; SPP RFCOMM
    Serial1.begin(GPS_BAUD, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
    Serial2.begin(10400, SERIAL_8N1, ECU_RX, ECU_TX);
    EEPROM.begin(512);

    byte savedBrightness = EEPROM.read(0);
    if (savedBrightness >= 10 && savedBrightness <= 100) {
        settingBrightness = savedBrightness;
    }
    
    byte savedBgBrightness = EEPROM.read(2);
    if (savedBgBrightness <= 100) settingBgBrightness = savedBgBrightness;

    byte savedBorder = EEPROM.read(1);
    if (savedBorder <= 14) { 
        settingBorderColor = savedBorder;
    }

    pinMode(TFT_BL, OUTPUT);
    analogWrite(TFT_BL, 0);

    SPI.begin(14, 12, 13, 15);
    tft.begin();
    tft.setRotation(1);

    // REDLINE XPT2046 driver: independent bit-banged pins, no shared SPI bus.
    ts.begin();
    ts.setCal(526, 3443, 750, 3377, 320, 240, true);

    if (!SD.begin(SD_CS)) {
        sdCardReady = false;
        DebugSerial.println("SD Card initialization failed!");
    } else {
        sdCardReady = true;
        DebugSerial.println("SD Card initialized.");
#if KLINE_RAW_SD_LOG
        // Use the File write() byte API instead of Print::print/println so this
        // remains compatible with SD library variants bundled by ArduinoDroid.
        auto rawLog = SD.open("/KLINE_RAW.TXT", FILE_APPEND);
        if (rawLog) {
            static const char sessionHeader[] =
                "\r\n--- Nattawut ECU V7 K-Line RAW session (READ ONLY) ---\r\n"
                "LOG=complete validated responses to sketch read requests (tables 17/20); read-only\r\n"
                "LIMIT=not a passive bus sniffer; unsolicited ECU traffic is not captured\r\n"
                "FORMAT=millis TABLE LEN HEX; remove SD card and open KLINE_RAW.TXT on a computer\r\n";
            rawLog.write((const uint8_t *)sessionHeader, sizeof(sessionHeader) - 1);
            rawLog.flush();
            rawLog.close();
        }
#endif
    }

    tft.fillScreen(ILI9341_BLACK);
    analogWrite(TFT_BL, (settingBrightness * 255) / 100);

    tft.drawRGBBitmap(0, 0, bootLogo, 320, 240);
    delay(3000);

    tft.fillScreen(ILI9341_BLACK);
    drawCurrentPage();
}

void loop() {
    serviceGps();
    serviceBluetoothCommands();
    serviceBluetoothTelemetry();
    if (millis() - lastUpdate > 50) {
        lastUpdate = millis();
        updatePeakValues();
        
        if (!isChoosingColor && (currentPage == 1 || currentPage == 2)) {
            updateLiveValues();
        }
    }

    // A link is shown only when the UART has received bytes recently.
    // No received bytes does not prove the cable is disconnected; ECU may be asleep.
    if (ecuResponseDetected && (millis() - lastEcuRxMs > 3000UL)) {
        ecuResponseDetected = false;
    }
    if (millis() - lastConnectionUiMs >= 500UL) {
        lastConnectionUiMs = millis();
        drawConnectionStatus();
        // Refresh the small SD indicator without redrawing the whole page.
        static unsigned long lastSdUiMs = 0;
        if (millis() - lastSdUiMs >= 1500UL) {
            lastSdUiMs = millis();
            drawSdCardStatus();
        }
    }

    // REDLINE-style stable touch sampling + release debounce; retain this sketch's tap/swipe actions.
    static bool panelDown = false;
    static uint32_t pressStarted = 0, lastValidTouch = 0;
    static long sumX = 0, sumY = 0;
    static int stableCount = 0, stableX = 0, stableY = 0;
    uint32_t nowTouch = millis();
    bool pressed = ts.Pressed();
    if (pressed) {
        if (!panelDown) {
            panelDown = true; pressStarted = nowTouch; sumX = sumY = 0; stableCount = 0;
            gestureStartX = stableX = ts.X(); gestureStartY = stableY = ts.Y();
            gestureLastX = stableX; gestureLastY = stableY; gesturePending = true;
            touchReleased = false;
        }
        lastValidTouch = nowTouch;
        if (nowTouch - pressStarted >= 20UL) {
            sumX += ts.X(); sumY += ts.Y(); stableCount++;
            stableX = sumX / stableCount; stableY = sumY / stableCount;
        } else if (stableCount == 0) { stableX = ts.X(); stableY = ts.Y(); }
        gestureLastX = stableX; gestureLastY = stableY;
        touchUpSince = 0;
    } else if (panelDown && nowTouch - lastValidTouch >= 60UL) {
        panelDown = false;
        int dx = gestureLastX - gestureStartX;
        int dy = gestureLastY - gestureStartY;
        if (gesturePending) {
            if (!isChoosingColor && abs(dx) >= 45 && abs(dy) <= 80) {
                int oldPage = currentPage;
                if (dx < 0) currentPage = (currentPage >= 6) ? 1 : currentPage + 1;
                else currentPage = (currentPage <= 1) ? 6 : currentPage - 1;
                if (currentPage != oldPage) { resetBars(); resetDisplayCache(); drawCurrentPage(); }
            } else if (abs(dx) < 45 && abs(dy) < 45) {
                if (isChoosingColor) handleColorPickerTouch(gestureStartX, gestureStartY);
                else handleTouchActions(gestureStartX, gestureStartY);
            }
        }
        gesturePending = false; touchReleased = true; lastTouchTime = nowTouch;
    }

    // Run blocking K-Line transactions only after touch processing and while
    // no finger is on the panel. This prevents UART timeouts/wake pulses from
    // interrupting an in-progress tap or swipe gesture.
    if (!panelDown) {
        serviceHondaKline();
    }
}

