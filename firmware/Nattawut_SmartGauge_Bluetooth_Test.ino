void redrawEcuFileListOnly() {
    uint16_t bColor = getBorderThemeColor();
    int startY = 33;
    for (int i = 0; i < 5; i++) {
        int fileIdx = fileScrollOffset + i;
        int rowY = startY + (i * 31) - 4;

        if (fileIdx < totalSimFiles) {
            bool isSelected = (fileIdx == selectedFileIndex);

            tft.fillRect(5, rowY, 185, 26, isSelected ? 0x0841 : ILI9341_BLACK);
            if (isSelected) {
                tft.drawRect(5, rowY, 185, 26, bColor);
            }

            tft.setTextColor(isSelected ? 0xFFE0 : 0xFFFF, isSelected ? 0x0841 : ILI9341_BLACK);
            tft.setCursor(8, startY + (i * 31));
            tft.print(isSelected ? ">" : " ");
            tft.print(simFiles[fileIdx]);

            tft.setTextColor(isSelected ? 0x07E0 : 0x7BEF, isSelected ? 0x0841 : ILI9341_BLACK);
            tft.setCursor(132, startY + (i * 31));
            tft.print(isSelected ? "[ACT]" : "[Sel]");
        } else {
            tft.fillRect(5, rowY, 185, 26, ILI9341_BLACK);
        }
    }

    int barX = 194;
    int barY = 28;
    int barH = 154;
    tft.fillRect(barX + 1, barY + 1, 16, barH - 2, ILI9341_BLACK);
    int handleH = (barH * 5) / totalSimFiles;
    if (handleH < 15) handleH = 15;
    int maxScroll = totalSimFiles - 5;
    int handleY = barY + 1;
    if (maxScroll > 0) {
        handleY = barY + (fileScrollOffset * (barH - handleH)) / maxScroll;
    }
    tft.fillRect(barX + 2, handleY, 14, handleH, bColor);

    lastDrawnScrollOffset = fileScrollOffset;
    lastDrawnSelectedFile = selectedFileIndex;
}

void updateEcuFileListSelection() {
    uint16_t bColor = getBorderThemeColor();
    int oldOffset = fileScrollOffset;
    if (selectedFileIndex < fileScrollOffset) {
        fileScrollOffset = selectedFileIndex;
    } else if (selectedFileIndex >= fileScrollOffset + 5) {
        fileScrollOffset = selectedFileIndex - 4;
    }

    if (fileScrollOffset != oldOffset) {
        redrawEcuFileListOnly();
        return;
    }

    int startY = 33;
    for (int i = 0; i < 5; i++) {
        int fileIdx = fileScrollOffset + i;
        if (fileIdx >= totalSimFiles) break;

        bool isSelected = (fileIdx == selectedFileIndex);
        bool wasSelected = (fileIdx == lastDrawnSelectedFile);

        if (isSelected != wasSelected) {
            int rowY = startY + (i * 31) - 4;
            tft.fillRect(5, rowY, 185, 26, isSelected ? 0x0841 : ILI9341_BLACK);
            if (isSelected) {
                tft.drawRect(5, rowY, 185, 26, bColor);
            }

            tft.setTextColor(isSelected ? 0xFFE0 : 0xFFFF, isSelected ? 0x0841 : ILI9341_BLACK);
            tft.setCursor(8, startY + (i * 31));
            tft.print(isSelected ? ">" : " ");
            tft.print(simFiles[fileIdx]);

            tft.setTextColor(isSelected ? 0x07E0 : 0x7BEF, isSelected ? 0x0841 : ILI9341_BLACK);
            tft.setCursor(132, startY + (i * 31));
            tft.print(isSelected ? "[ACT]" : "[Sel]");
        }
    }

    lastDrawnSelectedFile = selectedFileIndex;
}

