// Honda motorcycle K-Line protocol adapted directly from REDLINE Gauge 1.7.0
// src/data/honda_kline.h + src/data/honda_source.cpp.
// Read-only: wake pulse, ping/init, table 0x17 live data, table 0x20 O2.
// Wiring for this build: transceiver TXD -> ESP32 GPIO35 (RX),
// ESP32 GPIO22 (TX) -> transceiver RXD. GPIO35 is input-only.
#ifndef KLINE_INVERT
#define KLINE_INVERT 0
#endif

static uint8_t klineConsecutiveErrors = 0;
static const uint32_t KLINE_RETRY_MS = 5000;
static const uint32_t KLINE_POLL_MS = 80; // REDLINE-style frequent live-data polling
static unsigned long lastKlineLogMs = 0;
static unsigned long lastO2PollMs = 0;
static bool klineO2Available = true;
static uint8_t klineO2Misses = 0;
static float realAfrEstimate = 0.0f;
static float realO2Volts = 0.0f;
static bool realO2Available = false;
static int realIat = 0;
static bool realIatAvailable = false;
// Injector pulse width is initialized to zero. The conversion helper below is
// ready for a confirmed 16-bit ECU field, but no byte offsets are guessed.
static float realInjectorMs = 0.0f;
static bool realInjectorAvailable = false;
static const float INJECTOR_SCALE_MS = 0.01f; // example scale; enable only after ECU spec confirms it

static float decodeInjectorPulseWidth16(uint8_t highByte, uint8_t lowByte) {
    const uint16_t raw = ((uint16_t)highByte << 8) | lowByte;
    return (float)raw * INJECTOR_SCALE_MS;
}

// Bluetooth Classic SPP telemetry. Unknown/unverified ECU fields are sent as NA.
static void btPrintInt(bool valid, int value) {
    if (valid) SerialBT.print(value); else SerialBT.print("NA");
}
static void btPrintFloat(bool valid, float value, uint8_t decimals = 2) {
    if (valid) SerialBT.print(value, decimals); else SerialBT.print("NA");
}
static void serviceBluetoothTelemetry() {
    if (!SerialBT.hasClient()) return;
    const unsigned long now = millis();
    if (now - lastBtTelemetryMs < 250UL) return; // 4 updates/second
    lastBtTelemetryMs = now;
    // CSV protocol v1: TAG,VER,RPM,TPS,ECT,IAT,BAT,O2,AFR,SPEED,INJ,IGN,MAP,STFT,LTFT
    SerialBT.print("NATTWUT,1,");
    btPrintInt(realRpmAvailable, realRpm); SerialBT.print(',');
    btPrintInt(realTpsAvailable, realTps); SerialBT.print(',');
    btPrintInt(realEctAvailable, realEct); SerialBT.print(',');
    btPrintInt(realIatAvailable, realIat); SerialBT.print(',');
    btPrintFloat(realBattAvailable, realBatt, 1); SerialBT.print(',');
    btPrintFloat(realO2Available, realO2Volts, 3); SerialBT.print(',');
    btPrintFloat(realO2Available, realAfrEstimate, 1); SerialBT.print(',');
    btPrintInt(realSpeedAvailable && (now - lastGpsFixMs < 3000UL), realSpeed); SerialBT.print(',');
    btPrintFloat(realInjectorAvailable, realInjectorMs, 2); SerialBT.print(',');
    SerialBT.print("NA,NA,NA,NA,NA\r\n"); // IGN/MAP/STFT/LTFT not decoded for this ECU yet
}


static uint8_t klineChecksum(const uint8_t *data, size_t len) {
    uint8_t sum = 0;
    for (size_t i = 0; i < len; ++i) sum = (uint8_t)(sum + data[i]);
    return (uint8_t)(0x100 - sum);
}

static bool klineFrameChecksumOk(const uint8_t *frame, size_t len) {
    if (len < 4 || frame[1] != len) return false;
    uint8_t sum = 0;
    for (size_t i = 0; i < len; ++i) sum = (uint8_t)(sum + frame[i]);
    return sum == 0;
}

// Receive one complete response frame and ignore the transceiver's local echo.
// This follows REDLINE's transact() behavior rather than searching arbitrary bytes.
static bool klineTransact(const uint8_t *req, uint8_t reqLen,
                          uint8_t *resp, size_t respCap,
                          uint32_t timeoutMs) {
    while (Serial2.available()) Serial2.read();
    Serial2.write(req, reqLen);
    Serial2.flush();

    uint32_t until = millis() + timeoutMs;
    uint8_t b = 0;
    uint8_t echoMatched = 0;
    size_t respLen = 0;

    // If the adapter echoes the request, consume it byte-for-byte.
    while (echoMatched < reqLen && (int32_t)(millis() - until) < 0) {
        bool got = false;
        uint32_t shortUntil = millis() + 40;
        while ((int32_t)(millis() - shortUntil) < 0) {
            if (Serial2.available()) {
                b = (uint8_t)Serial2.read();
                got = true;
                break;
            }
            delay(1);
        }
        if (!got) break;
        if (b == req[echoMatched]) {
            ++echoMatched;
        } else {
            if (respLen < respCap) resp[respLen++] = b;
            break;
        }
    }

    // If no echo was present, the first received byte is already response byte 0.
    if (respLen == 0 && echoMatched < reqLen) {
        while ((int32_t)(millis() - until) < 0 && !Serial2.available()) delay(1);
        if (!Serial2.available()) return false;
        resp[respLen++] = (uint8_t)Serial2.read();
    }

    while (respLen < 2 && (int32_t)(millis() - until) < 0) {
        if (Serial2.available()) resp[respLen++] = (uint8_t)Serial2.read();
        else delay(1);
    }
    if (respLen < 2) return false;

    uint8_t frameLen = resp[1];
    if (frameLen < 4 || frameLen > respCap) return false;
    while (respLen < frameLen && (int32_t)(millis() - until) < 0) {
        if (Serial2.available()) resp[respLen++] = (uint8_t)Serial2.read();
        else delay(1);
    }
    return respLen == frameLen && klineFrameChecksumOk(resp, respLen);
}

static bool hondaKeihinWakeAndInit() {
    DebugSerial.println("[KLINE] REDLINE Honda HDS wake/init");
    Serial2.end();

    const int idleLevel = KLINE_INVERT ? LOW : HIGH;
    const int kLowLevel = KLINE_INVERT ? HIGH : LOW;
    const int kHighLevel = KLINE_INVERT ? LOW : HIGH;

    pinMode(ECU_TX, OUTPUT);
    digitalWrite(ECU_TX, idleLevel);
    pinMode(ECU_RX, INPUT);

    // Require a stable idle-high line for 300 ms as in REDLINE reference.
    uint32_t idleStart = millis();
    while (millis() - idleStart < 300UL) {
        if (digitalRead(ECU_RX) != idleLevel) {
            DebugSerial.println("[KLINE] RX idle unstable (check transceiver output/polarity)");
            return false;
        }
        delay(1);
    }

    // Honda wake pulse: K-line LOW 70 ms, HIGH 130 ms.
    digitalWrite(ECU_TX, kLowLevel);
    delay(70);
    digitalWrite(ECU_TX, kHighLevel);
    delay(130);

    Serial2.begin(10400, SERIAL_8N1, ECU_RX, ECU_TX, KLINE_INVERT);
    delay(5);
    while (Serial2.available()) Serial2.read();

    const uint8_t pingReq[] = {0xFE, 0x04, 0x72, 0x8C};
    const uint8_t initReq[] = {0x72, 0x05, 0x00, 0xF0, 0x99};
    uint8_t resp[64];
    bool pingOk = klineTransact(pingReq, sizeof(pingReq), resp, sizeof(resp), 200)
                  && resp[0] == 0x0E;
    delay(20);
    bool initOk = klineTransact(initReq, sizeof(initReq), resp, sizeof(resp), 250)
                  && resp[0] == 0x02;

    DebugSerial.printf("[KLINE] idle=OK ping=%s init=%s invert=%d\n",
                  pingOk ? "OK" : "NO REPLY",
                  initOk ? "OK" : "NO REPLY", KLINE_INVERT);
    return pingOk || initOk;
}

static size_t klineQueryTable(uint8_t table, uint8_t *out,
                              size_t cap, uint16_t timeoutMs) {
    uint8_t req[5] = {0x72, 0x05, 0x71, table, 0};
    req[4] = klineChecksum(req, 4);
    if (!klineTransact(req, sizeof(req), out, cap, timeoutMs)) {
        if (millis() - lastKlineLogMs >= 1000UL) {
            lastKlineLogMs = millis();
            DebugSerial.printf("[KLINE] table %02X no valid frame\n", table);
        }
        return 0;
    }
    if (out[0] != 0x02 || out[2] != 0x71 || out[3] != table) return 0;
    return out[1];
}

// REDLINE HDS Table 0x17 layout used by the supplied reference source:
// p[0..1] RPM; p[3] TPS percent x2; p[5] temperature +40;
// p[7] intake temperature +40; p[10] battery volts x10.
// MAP, VSS, gear, injector pulse width, ignition advance and fuel trims are
// intentionally not decoded until a verified K58-T81 response layout is available.
static bool decodeHondaTable17(const uint8_t *frame, size_t len) {
    if (len < 19 || frame[0] != 0x02 || frame[2] != 0x71 ||
        frame[3] != 0x17 || !klineFrameChecksumOk(frame, len)) return false;

    const uint8_t *p = frame + 4;
    uint16_t rpm = ((uint16_t)p[0] << 8) | p[1];
    uint8_t tpsRaw = p[3];
    if (rpm > 20000 || tpsRaw > 200) return false;

    realRpm = (int)rpm;
    realRpmAvailable = true;
    realTps = (int)(tpsRaw * 0.5f + 0.5f);
    if (realTps > 100) realTps = 100;
    realTpsAvailable = true;

    realEctAvailable = false;
    if (p[5] != 0xFF) {
        int tempC = (int)p[5] - 40;
        if (tempC >= -40 && tempC <= 180) { realEct = tempC; realEctAvailable = true; }
    }
    // Table 0x17 byte p[7] is the mapped intake-air temperature field.
    realIatAvailable = (p[7] != 0xFF);
    if (realIatAvailable) realIat = (int)p[7] - 40;

    realBattAvailable = (p[10] >= 50 && p[10] <= 200);
    if (realBattAvailable) realBatt = p[10] / 10.0f;
    return true;
}

static bool decodeHondaTable20(const uint8_t *frame, size_t len) {
    if (len != 8 || frame[0] != 0x02 || frame[2] != 0x71 ||
        frame[3] != 0x20 || !klineFrameChecksumOk(frame, len)) return false;

    // Example 8-bit / 0-1.0 V scaling supplied for this project:
    // O2(V) = Raw * (Vref / ResolutionMax) = Raw * (1.0 / 255.0).
    // The ECU's actual Table 0x20 byte meaning and 0-1 V range still require
    // confirmation from a real vehicle capture before treating this as calibrated.
    const uint8_t raw = frame[4];
    realO2Volts = (float)raw * (1.0f / 255.0f);
    realO2Available = true;
    // Narrowband O2 gives only a rough rich/lean estimate, not measured AFR.
    const float v[] = {0.00f, 0.10f, 0.20f, 0.45f, 0.60f, 0.75f, 0.90f, 1.00f};
    const float a[] = {15.8f, 15.4f, 15.1f, 14.7f, 14.2f, 13.6f, 13.0f, 12.6f};
    if (realO2Volts <= v[0]) realAfrEstimate = a[0];
    else {
        realAfrEstimate = a[7];
        for (int i = 1; i < 8; ++i) {
            if (realO2Volts <= v[i]) {
                realAfrEstimate = a[i-1] + (realO2Volts-v[i-1])/(v[i]-v[i-1])*(a[i]-a[i-1]);
                break;
            }
        }
    }
    return true;
}

static void btSendRawKlineFrame(uint8_t table, const uint8_t *data, size_t len) {
    if (!SerialBT.hasClient() || !data || len == 0 || len > 64) return;
    SerialBT.print("NATTWUT_RAW,1,");
    SerialBT.print(millis()); SerialBT.print(',');
    SerialBT.print(table, HEX); SerialBT.print(',');
    SerialBT.print(len); SerialBT.print(',');
    for (size_t i = 0; i < len; ++i) {
        if (i) SerialBT.print(' ');
        if (data[i] < 16) SerialBT.print('0');
        SerialBT.print(data[i], HEX);
    }
    SerialBT.print("\r\n");
}

static void printRawFrame(const char *label, const uint8_t *data, size_t len) {
    DebugSerial.print(label);
    for (size_t i = 0; i < len; ++i) {
        DebugSerial.print(' ');
        if (data[i] < 16) DebugSerial.print('0');
        DebugSerial.print(data[i], HEX);
    }
    DebugSerial.println();
}

// Store complete validated ECU response frames for later byte matching.
// Logging is throttled independently per table to limit SD writes.
static void logRawKlineFrame(uint8_t table, const uint8_t *data, size_t len) {
#if KLINE_RAW_SD_LOG
    if (!sdCardReady || !data || len == 0 || len > 64) return;
    unsigned long now = millis();
    unsigned long *last = (table == 0x17) ? &lastRaw17LogMs : &lastRaw20LogMs;
    if (now - *last < 500UL) return;
    *last = now;
    auto f = SD.open("/KLINE_RAW.TXT", FILE_APPEND);
    if (!f) return;

    // Format one complete record in RAM, then write raw bytes. This avoids
    // Print overload differences between ESP32/ArduinoDroid SD implementations.
    char record[320];
    int used = snprintf(record, sizeof(record), "%lu ms TABLE=%02X LEN=%u HEX=",
                        now, (unsigned int)table, (unsigned int)len);
    if (used < 0 || (size_t)used >= sizeof(record)) {
        f.close();
        return;
    }
    size_t pos = (size_t)used;
    for (size_t i = 0; i < len && pos + 4 < sizeof(record); ++i) {
        int n = snprintf(record + pos, sizeof(record) - pos,
                         (i + 1 < len) ? "%02X " : "%02X", (unsigned int)data[i]);
        if (n < 0 || (size_t)n >= sizeof(record) - pos) break;
        pos += (size_t)n;
    }
    if (pos + 2 < sizeof(record)) {
        record[pos++] = '\r';
        record[pos++] = '\n';
    }
    f.write((const uint8_t *)record, pos);
    f.flush();
    f.close();
#endif
}

void pollHondaKline() {
    if (!klineInitOk && !hondaKeihinWakeAndInit()) {
        klineInitOk = false;
        ecuResponseDetected = false;
        ecuMonitorStatus = "No wake/init response";
        DebugSerial.println("[KLINE] Wake/init failed.");
        return;
    }
    klineInitOk = true;

    lastTable17Len = klineQueryTable(0x17, lastTable17, sizeof(lastTable17), 180);
    if (lastTable17Len) {
#if KLINE_RAW_DEBUG_MODE
        logRawKlineFrame(0x17, lastTable17, lastTable17Len);\n        btSendRawKlineFrame(0x17, lastTable17, lastTable17Len);
#endif
        printRawFrame("[KLINE] TABLE 17:", lastTable17, lastTable17Len);
        if (decodeHondaTable17(lastTable17, lastTable17Len)) {
            ecuResponseDetected = true;
            lastEcuRxMs = millis();
            ecuMonitorStatus = "Live data received";
        }
    }
    lastTable20Len = klineQueryTable(0x20, lastTable20, sizeof(lastTable20), 250);
    if (lastTable20Len) {
#if KLINE_RAW_DEBUG_MODE
        logRawKlineFrame(0x20, lastTable20, lastTable20Len);\n            btSendRawKlineFrame(0x20, lastTable20, lastTable20Len);
#endif
        printRawFrame("[KLINE] TABLE 20:", lastTable20, lastTable20Len);
        decodeHondaTable20(lastTable20, lastTable20Len);
    }
}

static void serviceHondaKline() {
    unsigned long now = millis();

    if (!klineInitOk) {
        if (now - lastKlinePollMs >= KLINE_RETRY_MS) {
            lastKlinePollMs = now;
            if (hondaKeihinWakeAndInit()) {
                klineInitOk = true;
                klineConsecutiveErrors = 0;
                ecuMonitorStatus = "ECU awake; reading";
                DebugSerial.println("[KLINE] initialized; polling HDS table 0x17.");
            } else {
                ecuResponseDetected = false;
                ecuMonitorStatus = "No wake/init response";
            }
        }
        return;
    }

    if (now - lastKlinePollMs < KLINE_POLL_MS) return;
    lastKlinePollMs = now;

    lastTable17Len = klineQueryTable(0x17, lastTable17, sizeof(lastTable17), 180);
    if (lastTable17Len) {
#if KLINE_RAW_DEBUG_MODE
        // Log the complete checksum-valid response BEFORE semantic decoding.
        // This preserves unfamiliar/long frames for later byte mapping.
        logRawKlineFrame(0x17, lastTable17, lastTable17Len);\n        btSendRawKlineFrame(0x17, lastTable17, lastTable17Len);
#endif
    }
    if (lastTable17Len && decodeHondaTable17(lastTable17, lastTable17Len)) {
        ecuResponseDetected = true;
        lastEcuRxMs = millis();
        ecuMonitorStatus = "Live data received";
        klineConsecutiveErrors = 0;
        if (millis() - lastKlineLogMs >= 1500UL) {
            lastKlineLogMs = millis();
            DebugSerial.printf("[KLINE] RPM=%d TPS=%d%% TEMP=%dC IAT=%s BATT=%.1fV\n",
                          realRpm, realTps, realEct,
                          realIatAvailable ? String(realIat).c_str() : "--",
                          realBatt);
        }
        delay(20); // same inter-request spacing used by REDLINE Gauge 1.7.0
    } else {
        if (klineConsecutiveErrors < 255) ++klineConsecutiveErrors;
        if (klineConsecutiveErrors >= 5) {
            DebugSerial.println("[KLINE] 5 invalid/missing table 0x17 replies; retrying init.");
            klineInitOk = false;
            ecuResponseDetected = false;
            ecuMonitorStatus = "Lost ECU data; retrying";
            lastKlinePollMs = millis();
            return;
        }
    }

    // Table 0x20 is optional; three misses mark O2 data unavailable (UI returns to 0.00 V).
    if (klineO2Available && millis() - lastO2PollMs >= 250UL) {
        lastO2PollMs = millis();
        lastTable20Len = klineQueryTable(0x20, lastTable20, sizeof(lastTable20), 100);
        if (lastTable20Len) {
#if KLINE_RAW_DEBUG_MODE
            // Keep valid raw response even if its data layout is not recognized.
            logRawKlineFrame(0x20, lastTable20, lastTable20Len);\n            btSendRawKlineFrame(0x20, lastTable20, lastTable20Len);
#endif
        }
        if (lastTable20Len && decodeHondaTable20(lastTable20, lastTable20Len)) {
            klineO2Misses = 0;
        } else if (++klineO2Misses >= 3) {
            klineO2Available = false;
            realO2Available = false;
            lastDisplayedO2Volts = -999.0f;
            DebugSerial.println("[KLINE] no valid O2 table 0x20; O2 display set to 0.00 V.");
        }
    }
}

// Honda PGM-FI DTC services: 0x73 = stored-memory DTC, 0x74 = current DTC.
// Table 01 request checksums are generated with the same Honda 8-bit checksum.
static bool readHondaDtcMemory(uint8_t service, uint8_t *frame, size_t cap, size_t &len) {
    len = 0;
    if (!frame || cap < 12 || (service != 0x73 && service != 0x74)) return false;
    uint8_t req[5] = {0x72, 0x05, service, 0x01, 0x00};
    req[4] = klineChecksum(req, 4); // 0x15 for 0x73; 0x14 for 0x74
    if (!klineTransact(req, sizeof(req), frame, cap, 250)) return false;
    len = frame[1];
    return len == 12 && frame[0] == 0x02 && frame[2] == service &&
           frame[3] == 0x01 && klineFrameChecksumOk(frame, len);
}

static const char *hondaDtcDescription(uint8_t code) {
    switch (code) {
        case 0x01: return "MAP sensor";
        case 0x07: return "ECT sensor";
        case 0x08: return "TP sensor";
        case 0x09: return "IAT sensor";
        case 0x0B: return "Speed sensor";
        case 0x0C: return "Injector circuit";
        case 0x15: return "O2 sensor";
        case 0x1D: return "IACV";
        case 0x21: return "ECM internal";
        default:   return "Honda FI fault";
    }
}

static void addHondaDtc(uint8_t code, uint8_t subcode, const char *status) {
    if (code == 0 && subcode == 0) return;
    char codeText[8];
    snprintf(codeText, sizeof(codeText), "%02X-%02X", code, subcode);
    for (int i = 0; i < dtcCount; ++i) {
        if (dtcList[i].code == codeText) {
            if (dtcList[i].status.indexOf(status) < 0) {
                dtcList[i].status += "+";
                dtcList[i].status += status;
            }
            return;
        }
    }
    if (dtcCount >= 8) return;
    dtcList[dtcCount].code = codeText;
    dtcList[dtcCount].desc = hondaDtcDescription(code);
    dtcList[dtcCount].status = status;
    ++dtcCount;
}

static void parseHondaDtcFrame(const uint8_t *frame, size_t len, const char *status) {
    // The Honda response carries three two-byte DTC slots at bytes 5..10;
    // byte 4 is a header/flag byte, not a DTC number.
    if (!frame || len != 12) return;
    for (size_t i = 5; i + 1 < len - 1; i += 2) {
        addHondaDtc(frame[i], frame[i + 1], status);
    }
}

static bool readBothHondaDtcBanks() {
    uint8_t stored[32], current[32];
    size_t storedLen = 0, currentLen = 0;
    dtcCount = 0;
    bool storedOk = readHondaDtcMemory(0x73, stored, sizeof(stored), storedLen);
    bool currentOk = readHondaDtcMemory(0x74, current, sizeof(current), currentLen);
    if (storedOk) parseHondaDtcFrame(stored, storedLen, "STORED");
    if (currentOk) parseHondaDtcFrame(current, currentLen, "ACTIVE");
    if (!storedOk && !currentOk) {
        dtcScanStatus = "DTC READ FAILED";
        return false;
    }
    if (dtcCount == 0) dtcScanStatus = "NO FAULT CODES";
    else dtcScanStatus = String(dtcCount) + " DTC FOUND";
    return true;
}

void drawRawFrameLine(int x, int y, const uint8_t *data, size_t len) {
    tft.setTextSize(1);
    tft.setTextColor(ILI9341_WHITE);
    tft.setCursor(x, y);
    if (!len) { tft.print("(no response)"); return; }
    // Fit up to 16 bytes per line on the 320px screen.
    size_t shown = len > 16 ? 16 : len;
    for (size_t i=0; i<shown; i++) {
        if (data[i] < 16) tft.print('0');
        tft.print(data[i], HEX);
        tft.print(' ');
    }
    if (len > shown) tft.print("...");
}

void updatePeakValues() {
    if (realSpeed > peakSpeed) peakSpeed = realSpeed;
    if (realRpm > peakRpm) peakRpm = realRpm;
    if (realTps > peakTps) peakTps = realTps;
    if (realEct > peakEct) peakEct = realEct;
    if (realBatt < minBatt) minBatt = realBatt;
}

void drawSdCardStatus() {
    // Compact SD indicator centered at the bottom edge of the 320x240 UI.
    // Green SD = card initialized/present; red SD = absent or unavailable.
    bool cardPresent = sdCardReady && (SD.cardType() != CARD_NONE);
    tft.fillRect(145, 231, 30, 9, ILI9341_BLACK);
    tft.setFont();
    tft.setTextSize(1);
    tft.setTextColor(cardPresent ? ILI9341_GREEN : ILI9341_RED, ILI9341_BLACK);
    tft.setCursor(153, 231);
    tft.print(F("SD"));
}

void drawCurrentPage() {
    // Keep the original boot logo as a dim, persistent page background.
    drawLogoBackground(23, 217);

    if (currentPage == 1) drawMainPage();
    else if (currentPage == 2) drawGaugePage();
    else if (currentPage == 3) drawPeakPage();
    else if (currentPage == 4) drawDtcPage();
    else if (currentPage == 5) { resetDisplayCache(); drawEcuFlashPage(); }
    else if (currentPage == 6) drawSettingPage();

    // Footer is last so the frame never draws over menu buttons.
    drawFooter();
    drawSdCardStatus();
}

void handleTouchActions(int x, int y) {
    // V7 footer navigation buttons; wrap through the six pages.
    if (y >= 190 && y <= 235) {
        int oldPage = currentPage;
        if (x >= 8 && x <= 108) currentPage = (currentPage <= 1) ? 6 : currentPage - 1;
        else if (x >= 212 && x <= 312) currentPage = (currentPage >= 6) ? 1 : currentPage + 1;
        if (currentPage != oldPage) { resetBars(); resetDisplayCache(); drawCurrentPage(); }
        return;
    }
    if (y >= 186) return;
    if (currentPage == 3) { 
        if (x >= 220 && x <= 316) {
            if (y >= 27 && y <= 75) { peakActiveBtn = 1; drawPeakPage(); } 
            else if (y >= 79 && y <= 127) { peakActiveBtn = 2; drawPeakPage(); } 
            else if (y >= 131 && y <= 179) { 
                peakActiveBtn = 3; 
                peakSpeed = 0; peakRpm = 0; peakTps = 0; peakEct = 0; minBatt = 15.0;
                drawPeakPage(); 
            }
        }
    }
    else if (currentPage == 4) {
        if (dtcClearConfirmOpen) {
            // Confirmation overlay: YES at left, CANCEL at right.
            if (y >= 105 && y <= 158 && x >= 8 && x <= 158) {
                dtcClearConfirmOpen = false;
                executeHondaClearDtc();
            } else if (y >= 105 && y <= 158 && x >= 162 && x <= 312) {
                dtcClearConfirmOpen = false;
                redrawDtcPageClean();
            }
            return;
        }
        // DTC buttons are side-by-side beneath the table.
        if (y >= 142 && y <= 184) {
            if (x >= 3 && x <= 159) {
                dtcActiveBtn = 1;
                startClearingDtc();
            }
            else if (x >= 161 && x <= 317) {
                dtcActiveBtn = 2;
                startRefreshingDtc();
            }
        }
    }
    else if (currentPage == 5) { 
        if (x >= 2 && x <= 217 && y >= 25 && y <= 185) {
            int clickedRow = (y - 26) / 32;
            if (clickedRow >= 0 && clickedRow < 5) {
                int targetIndex = fileScrollOffset + clickedRow;
                if (targetIndex < totalSimFiles && targetIndex != selectedFileIndex) {
                    selectedFileIndex = targetIndex;
                    updateEcuFileListSelection();
                }
            }
        }
        
        if (x >= 218 && x <= 320) {
            if (y >= 25 && y < 78) { 
                if (ecuActiveBtn != 1) { ecuActiveBtn = 1; drawEcuActionButtons(); }
                startEcuFlashing(simFiles[selectedFileIndex]); 
            } 
            else if (y >= 78 && y < 131) { 
                if (ecuActiveBtn != 2) { ecuActiveBtn = 2; drawEcuActionButtons(); }
                if (selectedFileIndex > 0) {
                    selectedFileIndex--;
                    updateEcuFileListSelection();
                }
            } 
            else if (y >= 131 && y <= 185) { 
                if (ecuActiveBtn != 3) { ecuActiveBtn = 3; drawEcuActionButtons(); }
                if (selectedFileIndex < totalSimFiles - 1) {
                    selectedFileIndex++;
                    updateEcuFileListSelection();
                }
            }
        }
    }
    else if (currentPage == 6) {
        // Screen backlight brightness (EEPROM address 0)
        if (x >= 140 && x <= 180 && y >= 31 && y <= 69) {
            settingBrightness -= 10;
            if (settingBrightness < 10) settingBrightness = 10;
            analogWrite(TFT_BL, (settingBrightness * 255) / 100);
            EEPROM.write(0, settingBrightness); EEPROM.commit();
            drawSettingPage();
        }
        else if (x >= 268 && x <= 308 && y >= 31 && y <= 69) {
            settingBrightness += 10;
            if (settingBrightness > 100) settingBrightness = 100;
            analogWrite(TFT_BL, (settingBrightness * 255) / 100);
            EEPROM.write(0, settingBrightness); EEPROM.commit();
            drawSettingPage();
        }
        // Background logo brightness (EEPROM address 2)
        else if (x >= 140 && x <= 180 && y >= 87 && y <= 125) {
            settingBgBrightness -= 10;
            if (settingBgBrightness < 0) settingBgBrightness = 0;
            EEPROM.write(2, settingBgBrightness); EEPROM.commit();
            drawCurrentPage();
        }
        else if (x >= 268 && x <= 308 && y >= 87 && y <= 125) {
            settingBgBrightness += 10;
            if (settingBgBrightness > 100) settingBgBrightness = 100;
            EEPROM.write(2, settingBgBrightness); EEPROM.commit();
            drawCurrentPage();
        }
        else if (y >= 145 && y <= 183) {
            isChoosingColor = true;
            drawColorPickerPopup();
        }
    }
}

