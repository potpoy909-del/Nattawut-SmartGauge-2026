static void executeHondaClearDtc() {
    uint8_t resp[32];
    size_t respLen = 0;
    const uint8_t clearReq[5] = {0x72, 0x05, 0x60, 0x01, 0x28};

    // Clear the complete DTC content area (table + action buttons) before drawing the dialog.
    tft.fillRect(2, 25, 316, 158, ILI9341_BLACK);
    tft.fillRect(12, 38, 296, 108, 0x0010);
    tft.drawRect(12, 38, 296, 108, getBorderThemeColor());
    tft.setTextSize(1);
    tft.setTextColor(0xFFE0, 0x0010);
    tft.setCursor(28, 65); tft.print("SENDING DTC CLEAR COMMAND...");

    if (!klineInitOk && !hondaKeihinWakeAndInit()) {
        dtcScanStatus = "ECU NOT CONNECTED - NOT CLEARED";
        tft.setCursor(28, 90); tft.setTextColor(0xF800, 0x0010);
        tft.print("ECU wake/init failed. No clear sent.");
        delay(1300);
        redrawDtcPageClean();
        return;
    }
    klineInitOk = true;
    bool txOk = klineTransact(clearReq, sizeof(clearReq), resp, sizeof(resp), 300);
    bool ackOk = false;
    if (txOk) {
        respLen = resp[1];
        ackOk = (respLen == 5 && resp[0] == 0x02 && resp[2] == 0x60 &&
                 resp[3] == 0x01 && resp[4] == 0x98 && klineFrameChecksumOk(resp, respLen));
    }

    if (!ackOk) {
        dtcScanStatus = "CLEAR NOT CONFIRMED";
        tft.setTextColor(0xF800, 0x0010);
        tft.setCursor(28, 91); tft.print("ECU did not confirm clear request.");
        delay(1500);
        redrawDtcPageClean();
        return;
    }

    delay(80);
    bool rereadOk = readBothHondaDtcBanks();
    tft.setTextColor(0xFFFF, 0x0010);
    tft.setCursor(28, 91);
    if (rereadOk && dtcCount == 0) {
        dtcScanStatus = "CLEAR VERIFIED - NO DTC";
        tft.setTextColor(0x07E0, 0x0010);
        tft.print("ECU confirmed; no codes remain.");
    } else if (rereadOk) {
        dtcScanStatus = "CLEAR ACK - DTC STILL PRESENT";
        tft.setTextColor(0xFFE0, 0x0010);
        tft.print("Some faults remain; check wiring/sensors.");
    } else {
        dtcScanStatus = "CLEAR ACK - VERIFY FAILED";
        tft.setTextColor(0xFFE0, 0x0010);
        tft.print("Clear ack received; reread failed.");
    }
    delay(1500);
    redrawDtcPageClean();
}

void startRefreshingDtc() {
    uint16_t bColor = getBorderThemeColor();
    // Clear the complete DTC content area (table + action buttons) before drawing the dialog.
    tft.fillRect(2, 25, 316, 158, ILI9341_BLACK);
