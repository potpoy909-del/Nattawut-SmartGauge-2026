void drawEngineStatusPanel() {
    // ECU link is valid only while real K-Line response bytes are recent.
    // Engine state is derived only from live RPM received from the ECU.
    int linkState = ecuResponseDetected ? 1 : 0;
    int engineState = -1; // -1 = unknown until ECU data is available
    if (ecuResponseDetected) engineState = (realRpm > 0) ? 1 : 0;

    if (linkState == lastEngineLinkStatus && engineState == lastEngineStatusCode) return;
    lastEngineLinkStatus = linkState;
    lastEngineStatusCode = engineState;

    // Dark-blue status panel is intentional; it provides contrast for the lamps.
    tft.fillRect(159, 131, 158, 52, 0x0841);
    tft.drawRect(158, 130, 160, 54, getBorderThemeColor());
    tft.setFont();
    tft.setTextSize(1);
    tft.setTextColor(0xFFFF, 0x0841);
    tft.setCursor(164, 136);
    tft.print("ENGINE STATUS");

    // K-Line communication lamp
    tft.setTextColor(0x07FF, 0x0841);
    tft.setCursor(165, 153);
    tft.print("ECU LINK");
    uint16_t linkColor = linkState ? ILI9341_GREEN : ILI9341_RED;
    tft.fillCircle(299, 156, 5, linkColor);
    tft.drawCircle(299, 156, 6, ILI9341_WHITE);
    tft.setTextColor(linkColor, 0x0841);
    tft.setCursor(263, 153);
    tft.print(linkState ? "OK" : "WAIT");

    // Engine-running lamp: green=RPM>0, red=ECU confirms 0 RPM, yellow=no live data.
    tft.setTextColor(0xFFE0, 0x0841);
    tft.setCursor(165, 169);
    tft.print("ENGINE");
    uint16_t engineColor = (engineState < 0) ? ILI9341_YELLOW :
                           (engineState == 1 ? ILI9341_GREEN : ILI9341_RED);
    tft.fillCircle(299, 172, 5, engineColor);
    tft.drawCircle(299, 172, 6, ILI9341_WHITE);
    tft.setTextColor(engineColor, 0x0841);
    tft.setCursor(248, 169);
    if (engineState < 0) tft.print("NO DATA");
    else tft.print(engineState ? "RUN" : "STOP");
}

