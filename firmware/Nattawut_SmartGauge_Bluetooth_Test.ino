    if (!klineInitOk && !hondaKeihinWakeAndInit()) {
        ecuResponseDetected = false;
        dtcCount = 0;
        dtcScanStatus = "ECU NO RESPONSE - CHECK K-LINE";
    } else {
        klineInitOk = true;
        bool ok = readBothHondaDtcBanks();
        ecuResponseDetected = ok;
        if (ok) {
            lastEcuRxMs = millis();
            ecuMonitorStatus = "DTC data received";
        }
    }

    tft.setTextColor(dtcScanStatus == "NO FAULT CODES" ? 0x07E0 : 0xFFE0, 0x0010);
    tft.setCursor(28, 91); tft.print(dtcScanStatus);
    delay(900);
    redrawDtcPageClean();
}

