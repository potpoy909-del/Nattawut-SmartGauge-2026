// Restore a small area of the dimmed logo background before updating live text.
// This prevents black rectangles while still erasing old digits cleanly.
void restoreLogoRect(int x, int y, int w, int h) {
    uint16_t line[320];
    if (x < 0) { w += x; x = 0; }
    if (y < 23) { h -= (23 - y); y = 23; }
    if (x + w > 320) w = 320 - x;
    if (y + h > 186) h = 186 - y;
    if (w <= 0 || h <= 0) return;
    int brightness = settingBgBrightness;
    if (brightness < 0) brightness = 0;
    if (brightness > 100) brightness = 100;
    for (int row = y; row < y + h; row++) {
        for (int col = 0; col < w; col++) {
            uint16_t c = pgm_read_word(&bootLogo[row * 320 + x + col]);
            uint8_t r = ((c >> 11) & 0x1F) * brightness / 100;
            uint8_t g = ((c >> 5) & 0x3F) * brightness / 100;
            uint8_t b = (c & 0x1F) * brightness / 100;
            line[col] = ((uint16_t)r << 11) | ((uint16_t)g << 5) | b;
        }
        tft.drawRGBBitmap(x, row, line, w, 1);
    }
}

// Render a dimmed copy of the original 320x240 bootLogo into the page body.
// Pixel brightness is scaled before drawing, leaving foreground UI readable.
void drawLogoBackground(int y, int h) {
    uint16_t line[320];
    if (settingBgBrightness < 0) settingBgBrightness = 0;
    if (settingBgBrightness > 100) settingBgBrightness = 100;
    for (int row = y; row < y + h && row < 240; row++) {
        for (int x = 0; x < 320; x++) {
            uint16_t c = pgm_read_word(&bootLogo[row * 320 + x]);
            uint8_t r = (c >> 11) & 0x1F;
            uint8_t g = (c >> 5) & 0x3F;
            uint8_t b = c & 0x1F;
            r = (uint32_t)r * settingBgBrightness / 100;
            g = (uint32_t)g * settingBgBrightness / 100;
            b = (uint32_t)b * settingBgBrightness / 100;
            line[x] = ((uint16_t)r << 11) | ((uint16_t)g << 5) | b;
        }
        tft.drawRGBBitmap(0, row, line, 320, 1);
    }
}

